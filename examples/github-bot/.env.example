# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Fine-grained PAT or classic token. Minimum useful scopes: repo (private
# repos + code search), notifications (the inbox), workflow (Actions
# dispatch/rerun), gist. The agent can do anything this token can do.
GITHUB_TOKEN=github_pat_...
TELEGRAM_BOT_TOKEN=...
# Any long random string; bearer token for the TTY WebSocket
TTY_TOKEN=...
