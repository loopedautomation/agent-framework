# Copy to .env and fill in. Never commit .env.

# Runs the model, and transcribes the voice notes that arrive.
OPENAI_API_KEY=sk-...

# Speaks the replies. eleven_multilingual_v2 is what makes one voice work
# across every language this bot interprets into.
ELEVENLABS_API_KEY=

# The bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
