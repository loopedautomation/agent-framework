# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Coolify → Keys & Tokens → API tokens. Scope it to the one team whose
# resources this agent should touch; a read-only token is a real option if
# you only want status and logs.
# Bare hostname, no scheme and no trailing slash: coolify.looped.sh
COOLIFY_HOST=coolify.example.com
COOLIFY_API_TOKEN=...
TELEGRAM_BOT_TOKEN=...
# Any long random string; bearer token for the TTY WebSocket
TTY_TOKEN=...
# CLI variant only (compose.cli.yaml): lets the embedded claude CLI's gh
# calls clone and push.
GH_TOKEN=github_pat_...
