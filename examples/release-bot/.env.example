# Copy to .env and fill in. Never commit .env.
# Subscription OAuth token from `claude setup-token` — authenticates both the
# orchestrator model and the embedded claude CLI. An sk-ant-api key also
# works for the orchestrator; the CLI needs the oat token or its own login.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# Fine-grained PAT with contents:rw + pull_requests:rw on the release repos.
GH_TOKEN=github_pat_...
TELEGRAM_BOT_TOKEN=123456:ABC-...
