# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=...
# PostHog personal API key with the query:read scope
POSTHOG_API_KEY=phx_...
# Numeric project id (Settings → Project, or the number in the PostHog URL)
POSTHOG_PROJECT_ID=12345
# Any long random string; bearer token for the TTY WebSocket
TTY_TOKEN=...
